{
  "name": "mam-chung",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "npm run dev -w @mam-chung/web",
    "dev:api": "npm run dev -w @mam-chung/api",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:local": "node scripts/dev-local.cjs",
    "seed:demo:local": "node scripts/seed-demo-local.cjs",
    "check:pwa": "node scripts/check-pwa.cjs",
    "qa:local": "node scripts/qa-local.cjs",
    "test:workflows": "npm run test -w @mam-chung/api -- --runTestsByPath src/tests/workflows.test.ts --coverage=false"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
