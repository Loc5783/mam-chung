# Generate a private file with: node scripts/prepare-production.cjs domain.tld you@domain.tld
DOMAIN=replace.example.com
ACME_EMAIL=replace@example.com
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MONGO_ROOT_PASSWORD=replace-with-generated-base64url-password
MONGO_APP_PASSWORD=replace-with-generated-base64url-password
MONGO_BACKUP_PASSWORD=replace-with-generated-base64url-password
BACKUP_INTERVAL_SECONDS=86400
